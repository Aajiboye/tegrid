{
  "info": {
    "_postman_id": "tegrid-flows-001",
    "name": "TradeExpertGrid - Job & Store Flows",
    "description": "Postman collection for testing the job listing → quotation → revision → payment flow and the store (products → cart → checkout → orders → payments) flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Obtain bearer tokens for the actors used in the flows.",
      "item": [
        {
          "name": "Home Owner Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"homeowner@example.com\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('homeOwnerToken', jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Trade Person Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/tradeperson/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tradeperson", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tradeperson@example.com\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('tradePersonToken', jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tradeexpertgrid.com\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Job Flow",
      "description": "Job listing → quotation → revision → payment → completion → review.",
      "item": [
        {
          "name": "List Job Types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/job-types?page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "job-types"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.items && jsonData.data.items.length > 0) {",
                  "    pm.collectionVariables.set('jobTypeId', jsonData.data.items[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Job Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fix leaking kitchen sink\",\n  \"description\": \"The kitchen sink is leaking from the pipe under the basin. Need a plumber urgently.\",\n  \"budget\": 500000,\n  \"currency\": \"NGN\",\n  \"preferredDate\": \"2026-11-15\",\n  \"preferredTime\": \"14:00\",\n  \"homeAddress\": \"12 Baker Street, Lagos\",\n  \"photos\": [\"https://example.com/leak.jpg\"],\n  \"jobTypeId\": \"{{jobTypeId}}\",\n  \"visibility\": \"PUBLIC\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('jobRequestId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Job Requests (Home Owner)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Trade Person: Submit Quotation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tradePersonToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotation",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotation"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"materials\": [\n    {\n      \"description\": \"PVC pipes\",\n      \"materialCode\": \"PVC-001\",\n      \"quantity\": 5,\n      \"unitPrice\": 50000,\n      \"vat\": 750\n    }\n  ],\n  \"tools\": [\n    {\n      \"description\": \"Pipe wrench\",\n      \"materialCode\": \"WR-001\",\n      \"quantity\": 1,\n      \"unitPrice\": 0,\n      \"vat\": 0\n    }\n  ],\n  \"workmanships\": [\n    {\n      \"description\": \"Labour for fixing leak\",\n      \"price\": 300000\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('quotationId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Trade Person: Get Quotation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tradePersonToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotation",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotation"]
            }
          }
        },
        {
          "name": "Home Owner: List Quotations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotations",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotations"]
            }
          }
        },
        {
          "name": "Home Owner: Accept Quotation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotations/{{quotationId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotations", "{{quotationId}}", "accept"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Accepted for immediate work\"\n}"
            }
          }
        },
        {
          "name": "Home Owner: Reject Quotation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotations/{{quotationId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotations", "{{quotationId}}", "reject"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Price is too high, please revise\"\n}"
            }
          }
        },
        {
          "name": "Trade Person: Revise After Home Owner Rejection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tradePersonToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotation/{{quotationId}}/revise",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotation", "{{quotationId}}", "revise"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"materials\": [\n    {\n      \"description\": \"PVC pipes (homeowner rejected revision)\",\n      \"materialCode\": \"PVC-001\",\n      \"quantity\": 3,\n      \"unitPrice\": 40000,\n      \"vat\": 750\n    }\n  ],\n  \"tools\": [],\n  \"workmanships\": [\n    {\n      \"description\": \"Labour for fixing leak\",\n      \"price\": 220000\n    }\n  ],\n  \"changeReason\": \"Reduced price after homeowner feedback\"\n}"
            }
          }
        },
        {
          "name": "Trade Person: Revise Quotation (Happy Path)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tradePersonToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotation/{{quotationId}}/revise",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotation", "{{quotationId}}", "revise"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"materials\": [\n    {\n      \"description\": \"PVC pipes (revised)\",\n      \"materialCode\": \"PVC-001\",\n      \"quantity\": 4,\n      \"unitPrice\": 45000,\n      \"vat\": 750\n    }\n  ],\n  \"tools\": [],\n  \"workmanships\": [\n    {\n      \"description\": \"Labour for fixing leak\",\n      \"price\": 250000\n    }\n  ],\n  \"changeReason\": \"Reduced material and labour cost\"\n}"
            }
          }
        },
        {
          "name": "Trade Person: List Revisions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tradePersonToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotation/{{quotationId}}/revisions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotation", "{{quotationId}}", "revisions"]
            }
          }
        },
        {
          "name": "Admin: Review Quotation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "quotations", "{{quotationId}}", "review"]
            }
          }
        },
        {
          "name": "Admin: Approve Quotation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/review-decision",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "quotations", "{{quotationId}}", "review-decision"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ADMIN_APPROVED\"\n}"
            }
          }
        },
        {
          "name": "Admin: Reject Quotation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/review-decision",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "quotations", "{{quotationId}}", "review-decision"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ADMIN_REJECTED\",\n  \"reason\": \"Pricing above market rate, please resubmit\"\n}"
            }
          }
        },
        {
          "name": "Trade Person: Revise After Admin Rejection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tradePersonToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotation/{{quotationId}}/revise",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotation", "{{quotationId}}", "revise"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"materials\": [\n    {\n      \"description\": \"PVC pipes (admin rejected revision)\",\n      \"materialCode\": \"PVC-001\",\n      \"quantity\": 3,\n      \"unitPrice\": 40000,\n      \"vat\": 750\n    }\n  ],\n  \"tools\": [],\n  \"workmanships\": [\n    {\n      \"description\": \"Labour for fixing leak\",\n      \"price\": 220000\n    }\n  ],\n  \"changeReason\": \"Reduced price after admin feedback\"\n}"
            }
          }
        },
        {
          "name": "Home Owner: Pay Upfront",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotations/{{quotationId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotations", "{{quotationId}}", "pay"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.reference) {",
                  "    pm.collectionVariables.set('jobPaymentReference', jsonData.data.reference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Paystack Callback (Job Payment)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payments/paystack/callback?reference={{jobPaymentReference}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "payments", "paystack", "callback"],
              "query": [{ "key": "reference", "value": "{{jobPaymentReference}}" }]
            }
          }
        },
        {
          "name": "Trade Person: Request Completion",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{tradePersonToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/quotation/request-completion",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "quotation", "request-completion"]
            }
          }
        },
        {
          "name": "Home Owner: Get Verification Code",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/verification-code",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "verification-code"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.code) {",
                  "    pm.collectionVariables.set('verificationCode', jsonData.data.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Home Owner: Verify Completion Code",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/verify-code",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "verify-code"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{verificationCode}}\"\n}"
            }
          }
        },
        {
          "name": "Home Owner: Complete Job",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "complete"]
            }
          }
        },
        {
          "name": "Admin: Release Initial Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/release-payment",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "quotations", "{{quotationId}}", "release-payment"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"releaseType\": \"INITIAL\",\n  \"reason\": \"Work started milestone\"\n}"
            }
          }
        },
        {
          "name": "Admin: Release Balance Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/release-payment",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "quotations", "{{quotationId}}", "release-payment"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"releaseType\": \"BALANCE\",\n  \"reason\": \"Job completed\"\n}"
            }
          }
        },
        {
          "name": "Home Owner: Review Trade Person",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{homeOwnerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/jobs/{{jobRequestId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "jobs", "{{jobRequestId}}", "review"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Great work, fixed the leak quickly.\"\n}"
            }
          }
        },
        {
          "name": "Public: List Reviews for Trade Person",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tradeperson/{{tradePersonId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tradeperson", "{{tradePersonId}}", "reviews"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Store Flow",
      "description": "Admin catalog setup → public browsing → cart → checkout → order → payment → delivery → rental return.",
      "item": [
        {
          "name": "Admin: Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/store/categories",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "store", "categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Power Tools\",\n  \"slug\": \"power-tools\",\n  \"description\": \"Electric and battery-powered tools\",\n  \"image\": \"https://example.com/power-tools.jpg\",\n  \"isActive\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('categoryId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin: List Categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/store/categories",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "store", "categories"]
            }
          }
        },
        {
          "name": "Admin: Create Purchase Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/store/products",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "store", "products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bosch Cordless Drill\",\n  \"description\": \"Professional 18V cordless drill\",\n  \"sku\": \"BOS-DRILL-001\",\n  \"category\": \"{{categoryId}}\",\n  \"images\": [\"https://example.com/drill.jpg\"],\n  \"type\": \"PURCHASE\",\n  \"prices\": [\n    {\n      \"currencyCode\": \"NGN\",\n      \"amount\": 500000\n    }\n  ],\n  \"stockQuantity\": 20\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('purchaseProductId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
