                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/kyc/trade-person/{{tradePersonKycUserId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "kyc",
                "trade-person",
                "{{tradePersonKycUserId}}",
                "reject"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Approve Home Owner KYC",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/kyc/home-owner/{{homeOwnerKycUserId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "kyc",
                "home-owner",
                "{{homeOwnerKycUserId}}",
                "approve"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reject Home Owner KYC",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Address proof mismatch\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/kyc/home-owner/{{homeOwnerKycUserId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "kyc",
                "home-owner",
                "{{homeOwnerKycUserId}}",
                "reject"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Admin Quotations",
      "item": [
        {
          "name": "List Quotations for Job",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{jobRequestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "quotations",
                "{{jobRequestId}}"
              ]
            },
            "description": "Provide `{{jobRequestId}}` from your job flow run."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var rows = jsonData.data || [];",
                  "if (rows.length > 0) {",
                  "  if (rows[0]._id) pm.collectionVariables.set('quotationId', rows[0]._id);",
                  "  if (rows[0].tradePerson && rows[0].tradePerson._id) pm.collectionVariables.set('tradePersonId', rows[0].tradePerson._id);",
                  "}",
                  "pm.test('Quotations listed', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Move Quotation to Admin Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "quotations",
                "{{quotationId}}",
                "review"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Review Decision: Approve Quotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ADMIN_APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/review-decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "quotations",
                "{{quotationId}}",
                "review-decision"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Review Decision: Reject Quotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ADMIN_REJECTED\",\n  \"reason\": \"Estimate exceeds approved budget\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/review-decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "quotations",
                "{{quotationId}}",
                "review-decision"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Quotation Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "quotations",
                "{{quotationId}}",
                "events"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Quotation Revisions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/revisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "quotations",
                "{{quotationId}}",
                "revisions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Release Initial Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"releaseType\": \"INITIAL\",\n  \"reason\": \"Initial milestone verified\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/release-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "quotations",
                "{{quotationId}}",
                "release-payment"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Release Balance Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"releaseType\": \"BALANCE\",\n  \"reason\": \"Final delivery confirmed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/{{quotationId}}/release-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "quotations",
                "{{quotationId}}",
                "release-payment"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Approve QA for Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/quotations/jobs/{{jobRequestId}}/approve-qa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "quotations",
                "jobs",
                "{{jobRequestId}}",
                "approve-qa"
              ]
            }
          },
          "response": []
        }
      ]
    }
